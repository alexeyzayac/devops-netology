# Локальные директории Terraform
.terraform/

# Файлы состояния Terraform
*.tfstate
*.tfstate.*

# Логи падений
crash.log
crash.*.log

# Файлы с переменными (часто содержат пароли и ключи)
# Не должны храниться в репозитории
*.tfvars
*.tfvars.json

# Override-файлы для локальных правок
# Обычно не коммитятся
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Временные lock-файлы, создаваемые terraform apply
.terraform.tfstate.lock.info

# Пример, как явно разрешить override-файл
# !example_override.tf

# Файлы плана terraform (terraform plan -out=...)
# пример: *tfplan*

# Файлы конфигурации Terraform CLI
.terraformrc
terraform.rc

# (Опционально) файлы графов terraform graph
# *.dot

# (Опционально) файлы plan, сохранённые перед destroy
# planout
